{
  "name": "kompas-mockupy",
  "private": true,
  "version": "0.1.0",
  "description": "Klikalne mockupy portalu mentoringowego Kompas (HTML/CSS/TypeScript, bez frameworka)",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=dist/app.js",
    "dev": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=dist/app.js --servedir=. --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
