{
  "name": "devmentor",
  "private": true,
  "version": "0.1.0",
  "description": "DevMentor — portal mentoringu 1:1 (monorepo)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @devmentor/app",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "db:migration:create": "npm run migration:create -w @devmentor/db --",
    "db:migration:up": "npm run migration:up -w @devmentor/db --",
    "db:migration:down": "npm run migration:down -w @devmentor/db --",
    "e2e": "npm run build && playwright test",
    "e2e:update": "npm run build && playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2"
  "name": "kompas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run typegen && eslint . && biome ci . && pnpm run lint:deps && pnpm run lint:dead",
    "lint:deps": "node scripts/check-dependencies.mjs",
    "lint:dead": "knip",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @kompas/core run db:migrate",
    "db:seed": "pnpm --filter @kompas/core run db:seed",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@kompas/config": "workspace:*",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
