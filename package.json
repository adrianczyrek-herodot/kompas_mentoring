{
  "name": "devmentor",
  "private": true,
  "version": "0.1.0",
  "description": "DevMentor — portal mentoringu 1:1 (monorepo)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @devmentor/app",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "db:migration:create": "npm run migration:create -w @devmentor/db --",
    "db:migration:up": "npm run migration:up -w @devmentor/db --",
    "db:migration:down": "npm run migration:down -w @devmentor/db --",
    "e2e": "npm run build && playwright test",
    "e2e:update": "npm run build && playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
