{
  "name": "kompas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run typegen && eslint . && biome ci . && pnpm run lint:deps && pnpm run lint:dead",
    "lint:deps": "node scripts/check-dependencies.mjs",
    "lint:dead": "knip",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @kompas/core run db:migrate",
    "db:seed": "pnpm --filter @kompas/core run db:seed",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@kompas/config": "workspace:*",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
