# Copy to .env (never commit real secrets). Matches docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=info
# Pooled connection (web): queries and sending jobs.
DATABASE_URL=postgres://kompas:kompas@localhost:5432/kompas
# Direct connection (worker, migrations): fetching jobs, cron, maintenance.
DATABASE_DIRECT_URL=postgres://kompas:kompas@localhost:5432/kompas
WORKER_PORT=8081
# SENTRY_DSN= # optional; Sentry stays inactive without it
