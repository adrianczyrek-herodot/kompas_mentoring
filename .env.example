# Do not put real secrets here and do not keep a plaintext `.env`.
# Store them in the OS keychain and load them at runtime instead:
#
#   scripts/secrets.sh import .env --remove   # migrate an existing .env
#   scripts/secrets.sh put BETTER_AUTH_SECRET # store one value
#   scripts/secrets.sh list                   # variable names only
#   eval "$(scripts/secrets.sh export)"       # or: pnpm secrets:run -- <command>
#
# This file documents the variable names only (safe to commit).
# Matches docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=info
# Pooled connection (web): queries and sending jobs.
DATABASE_URL=postgres://kompas:kompas@localhost:5432/kompas
# Direct connection (worker, migrations): fetching jobs, cron, maintenance.
DATABASE_DIRECT_URL=postgres://kompas:kompas@localhost:5432/kompas
WORKER_PORT=8081
# SENTRY_DSN= # optional; Sentry stays inactive without it
# Better Auth: session cookie secret and public origin, both required in production
# (secret: `openssl rand -base64 32`; store with `scripts/secrets.sh put BETTER_AUTH_SECRET`).
# BETTER_AUTH_URL=http://localhost:3000
# HIBP check of new passwords (on by default; `off` only for offline tests).
# AUTH_BREACHED_PASSWORD_CHECK=on
# Social sign-in (buttons appear only when both keys are set).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
