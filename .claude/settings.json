{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/*.p12)",
      "Read(./**/*.keystore)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.agents/skills/**/.env)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./secrets/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(~/.gitconfig)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .git*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh api -X DELETE*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(diskutil erase*)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(telnet *)",
      "Bash(history -c)",
      "Bash(security dump-keychain*)",
      "Bash(security find-generic-password*)",
      "WebFetch",
      "WebSearch",
      "mcp__*"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(pnpm publish*)",
      "Bash(npm publish*)",
      "Bash(git commit*)",
      "Bash(git rebase*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [],
    "filesystem": {
      "allowWrite": [
        ".",
        "/tmp",
        "~/.cache",
        "~/Library/Caches",
        "~/Library/pnpm",
        "~/.local/share/pnpm",
        "~/.pnpm-store"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gcloud",
        "~/.docker/config.json",
        "~/.npmrc",
        "~/.netrc",
        "~/.claude.json",
        "~/.claude/.credentials.json",
        "~/.claude/plugins",
        "~/Library/Keychains",
        "~/.config/op",
        "~/.config/1Password",
        "~/.password-store"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.claude",
        "~/.claude.json",
        "~/.agents",
        "~/Library/Keychains",
        "~/.gitconfig",
        "~/.zshrc",
        "~/.zprofile",
        "~/.bashrc",
        "~/.profile",
        "~/.config"
      ]
    },
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "registry.npmjs.org",
        "*.npmjs.org",
        "*.npmjs.com",
        "nodejs.org",
        "*.nodejs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "api.github.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com",
        "*.docker.com",
        "*.docker.io",
        "ghcr.io",
        "playwright.azureedge.net",
        "*.playwright.dev",
        "cdn.playwright.dev",
        "deb.debian.org",
        "security.ubuntu.com",
        "archive.ubuntu.com",
        "packages.microsoft.com",
        "sentry.io"
      ],
      "deniedDomains": [],
      "strictAllowlist": true,
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-commands.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
