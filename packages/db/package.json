{
  "name": "@devmentor/db",
  "private": true,
  "version": "0.1.0",
  "description": "Dostęp do danych: MikroORM + PostgreSQL, encje, migracje, rejestracja w kontenerze DI",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
