{
  "name": "@kompas/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./scheduling": "./src/modules/scheduling/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "node --env-file-if-exists=../../.env src/shared/infrastructure/db/cli/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/shared/infrastructure/db/cli/seed.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "awilix": "13.0.5",
    "dinero.js": "2.0.2",
    "neverthrow": "8.2.0",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "temporal-polyfill": "1.0.6",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kompas/config": "workspace:*",
    "@kompas/testing": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
